{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omodos",
  "main": "src/entry.js",
  "compatibility_date": "2026-09-01",
  "no_bundle": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/files/*"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MAINTENANCE",
        "class_name": "MaintenanceStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MaintenanceStore"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
